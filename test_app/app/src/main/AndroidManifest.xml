<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- ble-api's manifest adds the <queries> entry for the communicator and the
         meta-data its BleApi reads. -->
    <application
        android:icon="@android:drawable/sym_action_chat"
        android:label="BLE Test App"
        android:theme="@android:style/Theme.Material.Light.NoActionBar">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- The communicator binds this to deliver messages while no listener is
             registered (the activity isn't open). It also puts the app in the
             communicator's CAPS, so peers can send to it at any time. -->
        <service
            android:name=".ReceiveService"
            android:exported="true">
            <intent-filter>
                <action android:name="com.rouddy.bluetooth_communicator.action.RECEIVE" />
            </intent-filter>
        </service>
    </application>
</manifest>
